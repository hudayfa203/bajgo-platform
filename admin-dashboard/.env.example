# mock = fully in-browser fake data (no backend needed). live = real BajGo API.
NEXT_PUBLIC_API_MODE=mock
# Live API base (server-side proxy target). Must include /v1.
API_URL=http://localhost:4000/v1
# Socket.IO origin for the /rt namespace (live mode only)
NEXT_PUBLIC_WS_URL=http://localhost:4000
# dev | staging | production — shown as the environment badge in the top bar
NEXT_PUBLIC_APP_ENV=dev
# Secret used to sign the mock-mode session cookie (any long random string)
SESSION_SECRET=change-me-in-production
