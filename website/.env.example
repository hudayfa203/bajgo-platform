# Public base URL of the BajGo API (docs/API.md). Leave unset to run the site
# standalone from the local seed content in ./content (no backend needed).
NEXT_PUBLIC_API_URL=
# Server-side API URL (used by the form proxy routes). Falls back to NEXT_PUBLIC_API_URL.
API_URL=
# Canonical site URL used for sitemap, hreflang and the download QR code.
NEXT_PUBLIC_SITE_URL=https://baj-go.com
# development | staging | production — demo trip page (/t/demo) only exists when != production
APP_ENV=development
