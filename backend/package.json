{
  "name": "@bajgo/api",
  "version": "0.1.0",
  "private": true,
  "description": "BajGo API — NestJS 11 backend for rides and deliveries in Garowe",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput & node --watch dist/main.js",
    "db:migrate": "node scripts/migrate.mjs",
    "keys:dev": "node scripts/gen-keys.mjs",
    "openapi": "node scripts/export-openapi.mjs",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns e2e",
    "test:e2e": "jest --runInBand test/e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.44.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "multer": "^2.0.1",
    "nestjs-zod": "^5.0.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.38",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "typescript": "^5.8.0"
  }
}
