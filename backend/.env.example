# ── BajGo API environment ──────────────────────────────────────────────
APP_ENV=development            # development | staging | production
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=https://baj-go.com     # used for share links https://baj-go.com/t/<token>
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgres://bajgo:bajgo@localhost:5432/bajgo
REDIS_URL=redis://localhost:6379

# JWT (RS256). Generate dev keys with `npm run keys:dev`; in production mount real PEM files.
JWT_PRIVATE_KEY_FILE=./keys/dev-private.pem
JWT_PUBLIC_KEY_FILE=./keys/dev-public.pem
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# OTP / SMS
SMS_PROVIDER=console            # console | http
SMS_HTTP_URL=                   # HttpSmsProvider: POST JSON { to, text, sender_id }
SMS_HTTP_TOKEN=
SMS_SENDER_ID=BajGo
OTP_PEPPER=change-me-dev-pepper
OTP_TEST_NUMBERS=+252900000001,+252900000002     # non-production only
OTP_TEST_CODE=123456                             # non-production only

# Routing / geocoding (apps never hold map keys)
ROUTING_PROVIDER=haversine      # haversine | osrm
OSRM_URL=https://router.project-osrm.org
GEOCODING_PROVIDER=local        # local | nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Dispatch
DISPATCH_INLINE=false           # true → run the dispatch worker in-process synchronously (tests)
RUN_WORKER_IN_API=true          # run BullMQ worker inside the API process (dev); false in prod (use worker service)

# Payments
SANDBOX_MM_DELAY_MS=3000
SANDBOX_WEBHOOK_SECRET=sandbox-secret
EVC_PLUS_API_URL=
EVC_PLUS_MERCHANT_ID=
EVC_PLUS_API_KEY=
ZAAD_API_URL=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
SAHAL_API_URL=
SAHAL_MERCHANT_ID=
SAHAL_API_KEY=

# Push
PUSH_PROVIDER=console           # console | fcm
FCM_SERVICE_ACCOUNT_JSON=

# Uploads
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local          # local | s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Demo / dev (ignored in production)
DEMO_ADMIN_EMAIL=admin@baj-go.com
DEMO_ADMIN_PASSWORD=BajGo-admin-2026
